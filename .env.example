# Copy this file to .env and fill in what you need.

# Which model backs the agent: mock | anthropic | openai_compat
# "mock" is a scripted stand-in that needs no API key.
LLM_PROVIDER=mock

# --- Claude (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- DeepSeek / Qwen / OpenAI (LLM_PROVIDER=openai_compat) ---
# DeepSeek: https://api.deepseek.com                               model: deepseek-chat
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1      model: qwen-plus
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=deepseek-chat

# --- Faster image builds from mainland China (optional) ---
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
